[
  {
    "id": 1,
    "arabic": "ٱلرَّحْمَٰنُ",
    "transliteration": "Ar-Rahman",
    "name_en": "The Beneficent",
    "meaning_en": "The One who wills goodness and mercy for all His creatures",
    "meaning_ml": "പരമദയാലു",
    "audio": "/audio/asma/1.mp3",
    "desc_ml": "സൃഷ്ടികളോട് മുഴുവനും, അവർ വിശ്വാസികളാണെങ്കിലും അല്ലെങ്കിലും ഇഹലോകത്ത് അതിരറ്റ കാരുണ്യം ചൊരിയുന്നവൻ."
  },
  {
    "id": 2,
    "arabic": "ٱلرَّحِيمُ",
    "transliteration": "Ar-Raheem",
    "name_en": "The Merciful",
    "meaning_en": "The One who acts with extreme kindness",
    "meaning_ml": "കരുണാനിധി",
    "audio": "/audio/asma/2.mp3",
    "desc_ml": "പരലോകത്ത് സത്യവിശ്വാസികളോട് മാത്രം കാരുണ്യം കാണിക്കുന്നവൻ."
  },
  {
    "id": 3,
    "arabic": "ٱلْمَلِكُ",
    "transliteration": "Al-Malik",
    "name_en": "The King",
    "meaning_en": "The Sovereign Lord, The One with the complete Dominion",
    "meaning_ml": "സർവ്വാധിപതി",
    "audio": "/audio/asma/3.mp3",
    "desc_ml": "സർവ്വലോകങ്ങളുടെയും യഥാർത്ഥ രാജാവും പരമാധികാരിയും."
  },
  {
    "id": 4,
    "arabic": "ٱلْقُدُّوسُ",
    "transliteration": "Al-Quddus",
    "name_en": "The Most Holy",
    "meaning_en": "The One who is pure from any imperfection",
    "meaning_ml": "പരിശുദ്ധൻ",
    "audio": "/audio/asma/4.mp3",
    "desc_ml": "എല്ലാവിധ ന്യൂനതകളിൽ നിന്നും പോരായ്മകളിൽ നിന്നും പൂർണ്ണമായി മുക്തനായ പരിശുദ്ധൻ."
  },
  {
    "id": 5,
    "arabic": "ٱلسَّلَامُ",
    "transliteration": "As-Salam",
    "name_en": "The Giver of Peace",
    "meaning_en": "The One who is free from every imperfection",
    "meaning_ml": "സമാധാനം നൽകുന്നവൻ",
    "audio": "/audio/asma/5.mp3",
    "desc_ml": "സൃഷ്ടികൾക്ക് ശാന്തിയും സമാധാനവും അഭയവും നൽകുന്നവൻ."
  },
  {
    "id": 6,
    "arabic": "ٱلْمُؤْمِنُ",
    "transliteration": "Al-Mu'min",
    "name_en": "The Giver of Faith",
    "meaning_en": "The One who witnessed for Himself that no one is God but Him",
    "meaning_ml": "അഭയം നൽകുന്നവൻ",
    "audio": "/audio/asma/6.mp3",
    "desc_ml": "സത്യവിശ്വാസികൾക്ക് നിർഭയത്വം നൽകുന്നവനും തനിക്ക് തുല്യനായി മറ്റാരുമില്ലെന്ന് സ്വയം സാക്ഷ്യപ്പെടുത്തുന്നവനും."
  },
  {
    "id": 7,
    "arabic": "ٱلْمُهَيْمِنُ",
    "transliteration": "Al-Muhaymin",
    "name_en": "The Guardian",
    "meaning_en": "The One who witnesses the saying and deeds of His creatures",
    "meaning_ml": "സംരക്ഷകൻ",
    "audio": "/audio/asma/7.mp3",
    "desc_ml": "എല്ലാ കാര്യങ്ങളെയും നിരീക്ഷിക്കുകയും സംരക്ഷിക്കുകയും നിയന്ത്രിക്കുകയും ചെയ്യുന്നവൻ."
  },
  {
    "id": 8,
    "arabic": "ٱلْعَزِيزُ",
    "transliteration": "Al-Aziz",
    "name_en": "The All Mighty",
    "meaning_en": "The Defeater who is not defeated",
    "meaning_ml": "പ്രതാപശാലി",
    "audio": "/audio/asma/8.mp3",
    "desc_ml": "ആർക്കും പരാജയപ്പെടുത്താൻ കഴിയാത്ത സർവ്വശക്തനും പ്രതാപശാലിയും."
  },
  {
    "id": 9,
    "arabic": "ٱلْجَبَّارُ",
    "transliteration": "Al-Jabbar",
    "name_en": "The Compeller",
    "meaning_en": "The One that nothing happens in His Dominion except that which He willed",
    "meaning_ml": "പരമാധികാരി",
    "audio": "/audio/asma/9.mp3",
    "desc_ml": "താൻ ഉദ്ദേശിക്കുന്നതെന്തും തന്റെ സൃഷ്ടികളിൽ നടപ്പിലാക്കാൻ കഴിവുള്ള പരമാധികാരി."
  },
  {
    "id": 10,
    "arabic": "ٱلْمُتَكَبِّرُ",
    "transliteration": "Al-Mutakabbir",
    "name_en": "The Supreme",
    "meaning_en": "The One who is clear from the attributes of the creatures",
    "meaning_ml": "അഹങ്കാരത്തിന് അർഹൻ",
    "audio": "/audio/asma/10.mp3",
    "desc_ml": "എല്ലാ സൃഷ്ടികളുടെയും വിശേഷണങ്ങളിൽ നിന്നെല്ലാം ഉന്നതനും മഹത്വത്തിന് അർഹനുമായവൻ."
  },
  {
    "id": 11,
    "arabic": "ٱلْخَالِقُ",
    "transliteration": "Al-Khaliq",
    "name_en": "The Creator",
    "meaning_en": "The One who brings everything from non-existence to existence",
    "meaning_ml": "സ്രഷ്ടാവ്",
    "audio": "/audio/asma/11.mp3",
    "desc_ml": "ഇല്ലാത്തതിൽ നിന്നും എല്ലാത്തിനെയും സൃഷ്ടിച്ചവൻ."
  },
  {
    "id": 12,
    "arabic": "ٱلْبَارِئُ",
    "transliteration": "Al-Baari",
    "name_en": "The Evolver",
    "meaning_en": "The Maker, The Creator who has the Power to turn the entities",
    "meaning_ml": "രൂപം നൽകുന്നവൻ",
    "audio": "/audio/asma/12.mp3",
    "desc_ml": "സൃഷ്ടികൾക്ക് ഏറ്റവും അനുയോജ്യമായ രൂപവും ഘടനയും നൽകി അവയെ പരിപാലിക്കുന്നവൻ."
  },
  {
    "id": 13,
    "arabic": "ٱلْمُصَوِّرُ",
    "transliteration": "Al-Musawwir",
    "name_en": "The Fashioner",
    "meaning_en": "The One who forms His creatures in different pictures",
    "meaning_ml": "രൂപകല്പന ചെയ്യുന്നവൻ",
    "audio": "/audio/asma/13.mp3",
    "desc_ml": "ഓരോ സൃഷ്ടിക്കും അതിന്റേതായ പ്രത്യേക രൂപവും ഭാവവും നൽകി രൂപകൽപന ചെയ്യുന്നവൻ."
  },
  {
    "id": 14,
    "arabic": "ٱلْقَهَّارُ",
    "transliteration": "Al-Qahhar",
    "name_en": "The Subduer",
    "meaning_en": "The One who has the perfect Power and is dominant over everything",
    "meaning_ml": "അടങ്ങാത്തവൻ",
    "audio": "/audio/asma/14.mp3",
    "desc_ml": "സർവ്വ ചരാചരങ്ങളെയും തന്റെ അധികാരത്തിന് കീഴിൽ അടക്കിഭരിക്കുന്നവൻ."
  },
  {
    "id": 15,
    "arabic": "ٱلْوَهَّابُ",
    "transliteration": "Al-Wahhab",
    "name_en": "The Bestower",
    "meaning_en": "The One who is Generous in giving plenty without any return",
    "meaning_ml": "ഏറെ നൽകുന്നവൻ",
    "audio": "/audio/asma/15.mp3",
    "desc_ml": "യാതൊരു പ്രതിഫലവും ആഗ്രഹിക്കാതെ സൃഷ്ടികൾക്ക് ധാരാളമായി അനുഗ്രഹങ്ങൾ നൽകുന്നവൻ."
  },
  {
    "id": 16,
    "arabic": "ٱلرَّزَّاقُ",
    "transliteration": "Ar-Razzaq",
    "name_en": "The Provider",
    "meaning_en": "The Provider, The Sustainer",
    "meaning_ml": "ഭക്ഷണം നൽകുന്നവൻ",
    "audio": "/audio/asma/16.mp3",
    "desc_ml": "എല്ലാ സൃഷ്ടികൾക്കും ജീവിക്കാനാവശ്യമായ ഉപജീവനം (ഭക്ഷണം, വസ്ത്രം, പാർപ്പിടം) നൽകുന്നവൻ."
  },
  {
    "id": 17,
    "arabic": "ٱلْفَتَّاحُ",
    "transliteration": "Al-Fattah",
    "name_en": "The Opener",
    "meaning_en": "The Opener, The Reliever, The Judge",
    "meaning_ml": "വിജയം നൽകുന്നവൻ",
    "audio": "/audio/asma/17.mp3",
    "desc_ml": "സത്യവും അസത്യവും വേർതിരിക്കുകയും, അനുഗ്രഹങ്ങളുടെയും കാരുണ്യത്തിന്റെയും വാതിലുകൾ തുറന്നുകൊടുക്കുകയും ചെയ്യുന്നവൻ."
  },
  {
    "id": 18,
    "arabic": "ٱلْعَلِيمُ",
    "transliteration": "Al-Alim",
    "name_en": "The All-Knowing",
    "meaning_en": "The Knowledgeable; The One nothing is absent from His knowledge",
    "meaning_ml": "സർവ്വജ്ഞൻ",
    "audio": "/audio/asma/18.mp3",
    "desc_ml": "രഹസ്യവും പരസ്യവുമായ എല്ലാം സൂക്ഷ്മമായി അറിയുന്ന സർവ്വജ്ഞൻ."
  },
  {
    "id": 19,
    "arabic": "ٱلْقَابِضُ",
    "transliteration": "Al-Qabid",
    "name_en": "The Withholder",
    "meaning_en": "The Withholder, The Straightener",
