# Copy this file to .env and fill in your values.
# Never commit .env to git.
VITE_GOOGLE_CLIENT_ID=your-google-client-id-here.apps.googleusercontent.com
VITE_API_BASE_URL=http://localhost:8000
VITE_VERSIONHUB_URL=http://localhost:8000/api/v1/version-check
VITE_VERSIONHUB_APP_KEY=replace-with-the-versionhub-mobile-api-key
# Optional. Leave blank to use VersionHub's DEFAULT_MOBILE_APPLICATION_NAME
# (the current backend default is mobile_app).
VITE_VERSIONHUB_APPLICATION_NAME=
