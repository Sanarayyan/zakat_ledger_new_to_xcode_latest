# Export these variables in your server environment; Django does not load this file automatically.
DJANGO_DEBUG=false
DJANGO_SECRET_KEY=
DJANGO_ALLOWED_HOSTS=
DJANGO_CORS_ALLOWED_ORIGINS=
DJANGO_CSRF_TRUSTED_ORIGINS=
DJANGO_SECURE_SSL_REDIRECT=true
# Comma-separated allowed audiences from the Google Cloud project. Native Google login uses the Web client as server audience.
GOOGLE_CLIENT_IDS=

# Optional production services; install requirements-production.txt first.
DJANGO_DB_ENGINE=sqlite
# Set DJANGO_SQLITE_PATH only for isolated local/test databases.
# POSTGRES_DB=muslimplus
# POSTGRES_USER=muslimplus
# POSTGRES_PASSWORD=configure-through-secret-manager
# POSTGRES_HOST=your-managed-host
# POSTGRES_PORT=5432
# POSTGRES_SSLMODE=verify-full
# DJANGO_CACHE_LOCATION=rediss://your-managed-cache:6379/1

# Set to the number of trusted proxies only when they sanitize X-Forwarded-For.
DJANGO_NUM_PROXIES=0
